# Copy to .env.local for local development. Never commit real values.
# In Vercel: Project → Settings → Environment Variables.

# Public site URL. Production only; previews fall back to their VERCEL_URL.
SITE_URL=https://somethingclicks.com

# Supabase (Project Settings → API). The service role / secret key is server-only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Direct Postgres connection for the network features and import job
# (Supabase → Connect → Transaction pooler). Local example:
# SUPABASE_DB_URL=postgresql://postgres@/sc_dev?host=/tmp&port=5499
SUPABASE_DB_URL=

# Admin sign-in
ADMIN_EMAIL=you@somethingclicks.com
# 32+ random characters, e.g. `openssl rand -base64 48`
ADMIN_SESSION_SECRET=

# Salt for hashing visitor IPs used in rate limiting. Any long random string.
RATE_LIMIT_SALT=

# Resend (owner notification emails)
RESEND_API_KEY=
NOTIFY_EMAIL_TO=you@somethingclicks.com
NOTIFY_EMAIL_FROM=Something Clicks <alerts@somethingclicks.com>

# Google Analytics 4 (optional). Production only, e.g. G-XXXXXXXXXX
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Local development only: shows a "Dev sign-in" button on /admin/login when
# running `npm run dev`. Ignored in production builds.
# ADMIN_DEV_LOGIN=true
