# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.
# Never commit real values.

# --- Site ---
# Public URL of the site, no trailing slash. Used for Stripe redirects and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The anon / publishable key (safe for the browser; RLS protects data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role / secret key. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (TEST MODE: Developers → API keys, with "Test mode" on) ---
# Must start with sk_test_ (or rk_test_). Live keys are refused unless ALLOW_STRIPE_LIVE_MODE=true.
STRIPE_SECRET_KEY=sk_test_
# Signing secret of the webhook endpoint pointing at /api/webhooks/stripe (starts with whsec_).
STRIPE_WEBHOOK_SECRET=whsec_
# ALLOW_STRIPE_LIVE_MODE=false

# --- Resend (transactional email) ---
# Without a key, emails are skipped with a warning in the logs and the rest of the flow still works.
RESEND_API_KEY=
# Must be on a domain verified in Resend.
EMAIL_FROM=Something Clicks <hello@yourdomain.com>
# Where new-signup / new-application / booking-request alerts go.
ADMIN_NOTIFICATION_EMAIL=

# --- Referral attribution ---
# How long a partner link is remembered in the visitor's browser.
ATTRIBUTION_WINDOW_DAYS=90
# Query parameters that carry a partner's referral code (comma-separated). PromoteKit's name is unverified.
NEXT_PUBLIC_REFERRAL_PARAM_NAMES=via,ref

# --- PromoteKit (not used yet; integration stays in mock mode until Phase 0 is verified) ---
PROMOTEKIT_MODE=mock
# PROMOTEKIT_API_KEY=
